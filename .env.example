# Copy to .env and paste the scoped, spend-capped key we send you
# (reply to your invite email to get one). This is the only external
# dependency — everything else runs locally in Docker.
ANTHROPIC_API_KEY=

# Local infra defaults — match docker-compose.yml, safe to keep as-is for local dev.
# Host port 5433, not 5432 — docker-compose.yml remaps it to dodge a
# Postgres-already-running-locally collision. See its comment for why.
DATABASE_URL=postgres://brain:brain@localhost:5433/secondbrain
# Least-privilege runtime role (created by the first migration) — the API
# connects as this, never as `brain`, because `brain` is a Postgres
# superuser and superusers bypass Row-Level Security unconditionally.
APP_DATABASE_URL=postgres://app_user:app_user@localhost:5433/secondbrain
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio-root
MINIO_SECRET_KEY=minio-secret
DOCUMENTS_BUCKET=documents
QUEUE_ENDPOINT=http://localhost:9324
INGEST_QUEUE_NAME=ingest-queue
